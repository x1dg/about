---
interface Props {
  name: string;
  role: string;
  company: string;
  context: string;
  note?: string;
}
const { name, role, company, context, note } = Astro.props;
---
<div class="recommendation-item">
  <div class="recommendation-header">
    <span class="recommendation-name">{name}</span>
    <span class="recommendation-role">— {role} @ {company}</span>
  </div>
  <div class="project-desc">{context}</div>
  {note && <div class="project-desc recommendation-note">→ {note}</div>}
</div>
